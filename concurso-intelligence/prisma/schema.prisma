generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  sessionVersion Int             @default(0)
  name           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  logins         LoginHistory[]
  attempts       QuestionAttempt[]
  sessions       StudySession[]
  targets        UserContestTarget[]
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  ipHash    String?
  userAgent String?

  @@index([userId, loggedAt])
}

model AuthRateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ExamBoard {
  id        String    @id @default(cuid())
  name      String
  acronym   String    @unique
  website   String?
  exams     Exam[]
  questions Question[]
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  acronym  String?
  exams    Exam[]
  contests Contest[]
}

model Contest {
  id             String               @id @default(cuid())
  name           String
  year           Int
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  editalUrl      String?
  examDate       DateTime?
  status         ContestStatus        @default(PLANNED)
  positions      ContestPosition[]
  exams          Exam[]
  rankingRows    OfficialRankingRow[]
  targets        UserContestTarget[]

  @@unique([name, year])
}

model ContestPosition {
  id          String               @id @default(cuid())
  contestId   String
  contest     Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name        String
  area        String?
  vacancies   Int?
  exams       Exam[]
  rankingRows OfficialRankingRow[]

  @@unique([contestId, name, area])
}

model Exam {
  id             String           @id @default(cuid())
  contestId      String?
  contest        Contest?         @relation(fields: [contestId], references: [id])
  boardId        String
  board          ExamBoard        @relation(fields: [boardId], references: [id])
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  positionId     String?
  position       ContestPosition? @relation(fields: [positionId], references: [id])
  title          String
  year           Int
  examDate       DateTime?
  sourceUrl      String?
  sourceDocument String?
  sourceSha256   String?
  questions      Question[]

  @@index([boardId, year])
  @@index([contestId, positionId])
}

model Subject {
  id        String     @id @default(cuid())
  name      String     @unique
  topics    Topic[]
  questions Question[]
}

model Topic {
  id        String     @id @default(cuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Topic?     @relation("TopicTree", fields: [parentId], references: [id])
  children  Topic[]    @relation("TopicTree")
  questions Question[]

  @@unique([subjectId, name, parentId])
}

model Question {
  id                 String               @id @default(cuid())
  examId             String
  exam               Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  boardId            String
  board              ExamBoard            @relation(fields: [boardId], references: [id])
  subjectId          String?
  subject            Subject?             @relation(fields: [subjectId], references: [id])
  topicId            String?
  topic              Topic?               @relation(fields: [topicId], references: [id])
  number             Int?
  statement          String
  explanation        String?
  questionType       QuestionType         @default(MULTIPLE_CHOICE)
  status             QuestionStatus        @default(ACTIVE)
  sourceUrl          String?
  sourcePage         Int?
  sourceLabel        String?
  contentFingerprint String               @unique
  firstSeenAt        DateTime             @default(now())
  lastVerifiedAt     DateTime?
  choices            QuestionChoice[]
  answerKeys         QuestionAnswerKey[]
  attempts           QuestionAttempt[]
  provenance         QuestionProvenance[]

  @@index([boardId, subjectId, topicId])
  @@unique([examId, number])
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  text       String
  isCorrect  Boolean  @default(false)

  @@unique([questionId, label])
}

model QuestionAnswerKey {
  id          String        @id @default(cuid())
  questionId  String
  question    Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version     Int
  kind        AnswerKeyKind
  answer      String?
  isAnnulled  Boolean       @default(false)
  sourceUrl   String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([questionId, version])
  @@index([questionId, kind, version])
}

model QuestionProvenance {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceType  SourceType
  sourceUrl   String
  license     String?
  retrievedAt DateTime @default(now())
  sourceHash  String?
  notes       String?

  @@index([questionId, retrievedAt])
}

model StudySession {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId           String?
  positionName      String?
  questionIds       String[]          @default([])
  reviewQuestionIds String[]          @default([])
  startedAt         DateTime          @default(now())
  finishedAt        DateTime?
  attempts          QuestionAttempt[]
}

model QuestionAttempt {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    StudySession? @relation(fields: [sessionId], references: [id])
  questionId String
  question   Question      @relation(fields: [questionId], references: [id])
  selected   String?
  correct    Boolean
  answeredAt DateTime      @default(now())
  elapsedMs  Int?
  confidence Int?

  @@index([userId, answeredAt])
  @@index([userId, questionId])
}

model OfficialRankingRow {
  id           String          @id @default(cuid())
  contestId    String
  contest      Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  positionId   String
  position     ContestPosition @relation(fields: [positionId], references: [id])
  candidateKey String
  score        Decimal         @db.Decimal(10, 4)
  rank         Int?
  category     RankingCategory @default(GENERAL)
  sourceUrl    String
  sourcePage   Int?
  importedAt   DateTime        @default(now())

  @@unique([contestId, positionId, candidateKey, category])
  @@index([contestId, positionId, category, score])
}

model UserContestTarget {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  positionId  String?
  targetScore Decimal? @db.Decimal(10, 4)
  createdAt   DateTime @default(now())

  @@unique([userId, contestId, positionId])
}

enum ContestStatus {
  PLANNED
  REGISTRATION_OPEN
  EXAM_SCHEDULED
  RESULTS_PENDING
  RESULTS_PUBLISHED
  CLOSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuestionStatus {
  ACTIVE
  ANNULLED
  OUTDATED
  REVIEW_REQUIRED
}

enum AnswerKeyKind {
  PRELIMINARY
  FINAL
}

enum SourceType {
  OFFICIAL_PDF
  OFFICIAL_WEB
  OPEN_DATASET
  GITHUB_REPOSITORY
  MANUAL
}

enum RankingCategory {
  GENERAL
  BLACK
  PCD
  OTHER_QUOTA
}
