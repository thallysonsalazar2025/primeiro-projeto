generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  sessionVersion Int             @default(0)
  name           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  logins         LoginHistory[]
  attempts       QuestionAttempt[]
  sessions       StudySession[]
  targets        UserContestTarget[]
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  ipHash    String?
  userAgent String?

  @@index([userId, loggedAt])
}

model ExamBoard {
  id        String    @id @default(cuid())
  name      String
  acronym   String    @unique
  website   String?
  exams     Exam[]
  questions Question[]
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  acronym  String?
  exams    Exam[]
  contests Contest[]
}

model Contest {
  id             String               @id @default(cuid())
  name           String
  year           Int
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  editalUrl      String?
  examDate       DateTime?
  status         ContestStatus        @default(PLANNED)
  positions      ContestPosition[]
  exams          Exam[]
  rankingRows    OfficialRankingRow[]
  targets        UserContestTarget[]

  @@unique([name, year])
}

model ContestPosition {
  id          String               @id @default(cuid())
  contestId   String
  contest     Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name        String
  area        String?
  vacancies   Int?
  exams       Exam[]
  rankingRows OfficialRankingRow[]

  @@unique([contestId, name, area])
}

model Exam {
  id             String           @id @default(cuid())
  contestId      String?
  contest        Contest?         @relation(fields: [contestId], references: [id])
  boardId        String
  board          ExamBoard        @relation(fields: [boardId], references: [id])
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  positionId     String?
  position       ContestPosition? @relation(fields: [positionId], references: [id])
  title          String
  year           Int
  examDate       DateTime?
  sourceUrl      String?
  sourceDocument String?
  sourceSha256   String?
  questions      Question[]

  @@index([boardId, year])
  @@index([contestId, positionId])
}

model Subject {
  id        String     @id @default(cuid())
  name      String     @unique
  topics    Topic[]
  questions Question[]
}

model Topic {
  id        String     @id @default(cuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Topic?     @relation("TopicTree", fields: [parentId], references: [id])
  children  Topic[]    @relation("TopicTree")
  questions Question[]

  @@unique([subjectId, name, parentId])
}

model Question {
  id                 String               @id @default(cuid())
  examId             String
  exam               Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  boardId            String
  board              ExamBoard            @relation(fields: [boardId], references: [id])
  subjectId          String?
  subject            Subject?             @relation(fields: [subjectId], references: [id])
  topicId            String?
  topic              Topic?               @relation(fields: [topicId], references: [id])
  number             Int?
  statement          String
  explanation        String?
  questionType       QuestionType         @default(MULTIPLE_CHOICE)
  status             QuestionStatus        @default(ACTIVE)
  sourceUrl          String?
  sourcePage         Int?
  sourceLabel        String?
  contentFingerprint String               @unique
  firstSeenAt        DateTime             @default(now())
  lastVerifiedAt     DateTime?
  choices            QuestionChoice[]
  attempts           QuestionAttempt[]
  provenance         QuestionProvenance[]

  @@index([boardId, subjectId, topicId])
  @@index([examId, number])
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  text       String
  isCorrect  Boolean  @default(false)

  @@unique([questionId, label])
}

model QuestionProvenance {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceType  SourceType
  sourceUrl   String
  license     String?
  retrievedAt DateTime @default(now())
  sourceHash  String?
  notes       String?

  @@index([questionId, retrievedAt])
}

model StudySession {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestId         String?
  boardId           String?
  positionId        String?
  subjectId         String?
  topicId           String?
  mode              StudySessionMode  @default(PRACTICE)
  requestedCount    Int
  status            StudySessionStatus @default(IN_PROGRESS)
  startedAt         DateTime          @default(now())
  finishedAt        DateTime?
  currentIndex      Int               @default(0)
  elapsedSeconds    Int               @default(0)
  attempts          QuestionAttempt[]

  @@index([userId, status, startedAt])
}

model QuestionAttempt {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoice String?
  correct        Boolean?
  markedReview   Boolean      @default(false)
  answeredAt     DateTime?
  elapsedSeconds Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sessionId, questionId])
  @@index([userId, createdAt])
}

model OfficialRankingRow {
  id           String          @id @default(cuid())
  contestId    String
  contest      Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  positionId   String
  position     ContestPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateKey String
  category     RankingCategory @default(GENERAL)
  score        Float
  officialRank Int?
  sourceUrl    String
  sourcePage   Int?
  importedAt   DateTime        @default(now())

  @@unique([contestId, positionId, candidateKey, category])
  @@index([contestId, positionId, category, score])
}

model UserContestTarget {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestId  String
  contest    Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  positionId String?
  targetScore Float?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, contestId, positionId])
}

enum ContestStatus {
  PLANNED
  OPEN
  CLOSED
  COMPLETED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuestionStatus {
  ACTIVE
  ANNULLED
  DISPUTED
  OUTDATED
}

enum SourceType {
  OFFICIAL_PDF
  OFFICIAL_WEB
  GITHUB_REPOSITORY
  MANUAL
}

enum StudySessionMode {
  PRACTICE
  EXAM
}

enum StudySessionStatus {
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum RankingCategory {
  GENERAL
  PCD
  BLACK
}
